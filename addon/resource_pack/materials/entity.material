{
  "materials": {
    "version": "1.0.0",
    "bongocatmc_mesh:entity_for_skeleton": {
      "vertexShader": "shaders/glsl/bongocatmc.vertex",
      "fragmentShader": "shaders/glsl/bongocatmc.fragment",
      "states": [
        "Blending",
        "DisableCulling",
        "DisableDepthWrite",
        "DisableDepthTest"
      ],
      "blendSrc": "SourceAlpha",
      "blendDst": "OneMinusSrcAlpha",
      "msaaSupport": "Both",
      "+samplerStates": [
        {
          "samplerIndex": 0,
          "textureFilter": "Bilinear"
        },
        {
          "samplerIndex": 1,
          "textureFilter": "Point"
        },
        {
          "samplerIndex": 2,
          "textureFilter": "Point"
        }
      ]
    }
  }
}
