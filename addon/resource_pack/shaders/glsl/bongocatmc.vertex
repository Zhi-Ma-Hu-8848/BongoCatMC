// __multiversion__
#include "bongocatmc_precision.h"
#include "neteaseModelVertexUtil.h"
#include "uniformMacro.h"
#include "bongocatmc_data.h"
LAYOUT_BINDING(1) uniform sampler2D TEXTURE_1;
LAYOUT_BINDING(2) uniform sampler2D TEXTURE_2;
uniform highp vec4 EXTRA_VECTOR1;
uniform highp vec4 EXTRA_VECTOR2;
uniform highp vec4 EXTRA_VECTOR3;
uniform highp vec4 EXTRA_VECTOR4;
varying highp vec2 sourceUV;
varying highp vec2 maskUV;
varying highp vec4 maskBounds;
varying highp float masked;
varying highp float inverted;
varying highp float opacity;
varying highp vec2 canvasPoint;
varying highp float clipToCanvas;
vec2 decode(vec4 p){vec4 b=floor(p*255.0+.5);return vec2(b.r*256.0+b.g,b.b*256.0+b.a)/65535.0;}
vec4 meta(float i){return texture2D(TEXTURE_2,vec2(mod(i,512.0)+.5,floor(i/512.0)+.5)/vec2(512.0,META_H));}
vec2 sampleValue(float frame,float index){float i=frame*STRIDE+index;return decode(texture2D(TEXTURE_1,vec2(mod(i,DATA_W)+.5,floor(i/DATA_W)+.5)/vec2(DATA_W,DATA_H)));}
vec2 head(float base,float index){
 vec2 xy=clamp(EXTRA_VECTOR1.xy,vec2(0.0),vec2(4.0)),lo=floor(xy),hi=ceil(xy),t=fract(xy);
 return mix(mix(sampleValue(base+lo.y*5.0+lo.x,index),sampleValue(base+lo.y*5.0+hi.x,index),t.x),
            mix(sampleValue(base+hi.y*5.0+lo.x,index),sampleValue(base+hi.y*5.0+hi.x,index),t.x),t.y);
}
vec2 bank(float start,float level,float index){
 return mix(head(start+25.0*floor(level),index),head(start+25.0*ceil(level),index),fract(level));
}
vec2 value(float index,float effect){
 if(effect>.5 && effect<1.5)return bank(BANK_GLASSES,clamp(EXTRA_VECTOR4.x,0.0,1.0)*STEPS_GLASSES,index);
 if(effect>1.5 && effect<2.5)return bank(BANK_HALO,clamp(EXTRA_VECTOR4.y,0.0,1.0)*STEPS_HALO,index);
 if(effect>2.5 && effect<3.5 && EXTRA_VECTOR4.z>0.0)return bank(BANK_WAVE,clamp(EXTRA_VECTOR4.z,0.0,30.0),index);
 if(effect>3.5){
  float level=clamp(EXTRA_VECTOR4.w,0.0,1.0)*30.0;
  return mix(bank(BANK_FLASH0,level,index),bank(BANK_FLASH,level,index),clamp(EXTRA_VECTOR2.w,0.0,1.0));
 }
 float base=25.0*(4.0*EXTRA_VECTOR1.w+2.0*EXTRA_VECTOR2.x+EXTRA_VECTOR2.y);
 return mix(head(base,index),head(base+200.0,index),clamp(EXTRA_VECTOR1.z,0.0,1.0));
}
void main(){
 vec2 point; masked=0.0;inverted=0.0;maskUV=vec2(0.0);maskBounds=vec4(0.0);clipToCanvas=1.0;
 if(TEXCOORD_0.y>.7){
  vec2 corner=vec2(TEXCOORD_0.x,step(.85,TEXCOORD_0.y));
  point=(corner-vec2(.5))*vec2(612.0/354.0,-1.0);
  sourceUV=(vec2(0.0,1536.0)+corner*vec2(612.0,354.0))/2048.0;
  opacity=1.0;
 }else if(TEXCOORD_0.y>.4){
  vec2 corner=vec2(TEXCOORD_0.x,step(.55,TEXCOORD_0.y));
  float key=max(0.0,floor(EXTRA_VECTOR2.z+.5));
  vec2 atlasOrigin=floor(decode(meta(KEY_META+key*3.0))*65535.0+.5);
  vec2 canvasOrigin=floor(decode(meta(KEY_META+key*3.0+1.0))*65535.0+.5);
  vec2 cropSize=floor(decode(meta(KEY_META+key*3.0+2.0))*65535.0+.5);
  point=(canvasOrigin+corner*cropSize-vec2(306.0,177.0))*vec2(1.0,-1.0)/354.0;
  sourceUV=(atlasOrigin+corner*cropSize)/2048.0;
  opacity=EXTRA_VECTOR1.w;
 }else{
  float vertex=floor(TEXCOORD_0.x*512.0+.5),mi=vertex*4.0;
  sourceUV=decode(meta(mi));vec4 info=floor(meta(mi+1.0)*255.0+.5);
  // Render all live model parts beyond the nominal 612x354 canvas. Masks
  // and drawable opacity still control their original shape/visibility.
  clipToCanvas=0.0;
  // Inactive glasses stay opaque in Core and are parked outside the canvas.
  // Keep that hiding mechanism only while this expression is fully off.
  if(info.a>.5 && info.a<1.5 && EXTRA_VECTOR4.x<=0.0)clipToCanvas=1.0;
  point=value(vertex,info.a)*8.0-4.0;opacity=value(VERTICES+info.r,info.a).x;
  masked=info.g>.5?1.0:0.0;inverted=info.b;
  if(masked>.5)maskUV=value(VERTICES+DRAWABLES+info.g-1.0,info.a)*4.0-2.0;
  maskBounds=vec4(decode(meta(mi+2.0)),decode(meta(mi+3.0)));
 }
 canvasPoint=point;
 // Mirror the assembled model about its canvas centre, after evaluating
 // masks and poses, so keyboard art and effects follow the same transform.
 float mirror=floor(EXTRA_VECTOR3.w+.5);
 point*=vec2(1.0-2.0*mod(mirror,2.0),1.0-2.0*step(2.0,mirror));
 vec4 posed=vec4(point*24.0*max(EXTRA_VECTOR3.x,.01)+vec2(EXTRA_VECTOR3.y,16.0+EXTRA_VECTOR3.z),0.0,1.0);
#if defined(USE_SKINNING) && defined(NETEASE_SKINNING)
 posed=GetBoneMatForNetease(int(BONEID_0))*posed;
#endif
 gl_Position=WORLDVIEWPROJ*posed;
}
