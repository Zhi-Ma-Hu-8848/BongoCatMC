{
  "name": "bongocatmc-build-tools",
  "private": true,
  "license": "SEE LICENSE IN COPYRIGHT.md",
  "scripts": {
    "check:licenses": "python tools/sync_license_notices.py --check",
    "check:audio": "python tools/submission_audio.py",
    "live2d": "python tools/live2d_pipeline.py",
    "test:conversion": "python tools/test_live2d_pipeline.py",
    "sample:cat": "node tools/sample_cat.cjs",
    "sample:deepseek": "node tools/sample_deepseek_parameters.cjs",
    "build:deepseek": "npm run sample:deepseek && python tools/build_deepseek.py",
    "reference:deepseek": "esbuild tools/reference_deepseek_physics.ts --bundle --platform=node --format=cjs --outfile=build/reference_deepseek_physics.cjs && node build/reference_deepseek_physics.cjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
